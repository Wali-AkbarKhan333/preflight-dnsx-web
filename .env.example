PORT=3000
HOST=0.0.0.0

# Optional. Leave empty to auto-detect tools/dnsx(.exe) or dnsx on PATH.
DNSX_PATH=

# Optional first-run bootstrap. Recommended before exposing a fresh server publicly.
# If the database already contains users, these values are ignored.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Authentication/session settings.
SESSION_DAYS=14
# auto = add Secure cookie flag when HTTPS is detected through the request/proxy.
# Set true when the app is permanently behind HTTPS; false only for local HTTP testing.
COOKIE_SECURE=auto

# Upload / result-file retention.
# Scan history remains in SQLite. Only job input/output files expire.
MAX_UPLOAD_MB=25
RESULT_FILE_RETENTION_HOURS=720

# Safe defaults for dnsx. Users can lower these in the UI per job.
DEFAULT_THREADS=200
DEFAULT_RATE_LIMIT=2000
MAX_THREADS=500
MAX_RATE_LIMIT=10000

# Number of unique domains per dnsx batch/checkpoint. After a crash, only the unfinished batch is repeated.
# 5000 is the recommended balance for large scans.
SCAN_CHUNK_SIZE=5000

# Keep this at 1 on the free Oracle VM so large scans do not compete for DNS/CPU/network resources.
MAX_CONCURRENT_SCANS=1

# Milestone 1 consistency: pin the same resolver pool on local and live deployments.
DNS_RESOLVERS=1.1.1.1,8.8.8.8,9.9.9.9

# Main MX lookup retry count. A second attempt is used only when dnsx needs it,
# reducing the chance that a transient dropped MX response is mistaken for NO_MX.
MAIN_RETRY_ATTEMPTS=2

# Domains with no usable MX JSON result are checked again with an explicit DNS
# response-code probe. This is what distinguishes NO_MX/NXDOMAIN from true UNKNOWN.
# Each resolver is tried separately only for domains that are still uncertain.
UNKNOWN_RETRY_RESOLVERS=1.1.1.1,8.8.8.8,9.9.9.9
UNKNOWN_RETRY_THREADS=50
UNKNOWN_RETRY_RATE_LIMIT=250
UNKNOWN_RETRY_ATTEMPTS=2
UNKNOWN_RETRY_TIMEOUT_SECONDS=4
