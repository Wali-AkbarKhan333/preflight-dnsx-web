PORT=3000
HOST=0.0.0.0

# Optional. Leave DNSX_PATH empty to auto-detect tools/dnsx(.exe) or dnsx on PATH.
DNSX_PATH=

# Protect the app before exposing it publicly.
# If APP_PASSWORD is blank, authentication is disabled.
APP_USERNAME=admin
APP_PASSWORD=

# Upload / retention settings
MAX_UPLOAD_MB=25
JOB_RETENTION_HOURS=24

# Safe defaults for dnsx. Users can lower these in the UI per job.
DEFAULT_THREADS=100
DEFAULT_RATE_LIMIT=1000
MAX_THREADS=300
MAX_RATE_LIMIT=5000
